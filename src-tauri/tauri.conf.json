{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CapSage",
  "version": "0.1.4",
  "identifier": "com.robmirabelle.capsage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14310",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CapSage",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#22252f"
      },
      {
        "label": "splash",
        "title": "CapSage",
        "width": 480,
        "height": 250,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "focus": true,
        "shadow": true,
        "backgroundColor": "#1d2029"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["icons/icon.ico", "icons/capsage-document.ico"],
    "fileAssociations": [
      {
        "ext": ["capsage"],
        "name": "CapSage.Document",
        "description": "CapSage document"
      }
    ],
    "windows": {
      "nsis": {
        "template": "installer.nsi"
      }
    }
  }
}
